# Secrets and local config — never commit
.env
secrets/
*.json.key
*credentials*.json

# Model weights (large artifacts)
*.pt
*.onnx
*.engine

# Server-local runtime dir (snapshots fallback) - never commit
server/data/

# Runtime detection snapshots (regenerated every run, can grow big) - never commit.
# Showcase pictures live in screenshots/ instead (safe from snapshot cleanup).
data/snapshots/*
!data/snapshots/.gitkeep



# Input media content (provided by owner, read-only) — keep the folders, ignore the files
videos/*
!videos/.gitkeep
images/*
!images/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Go
bin/
dist/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent tooling dependencies (skills themselves are committed)
.opencode/node_modules/
