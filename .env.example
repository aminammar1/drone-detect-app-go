# =====================================================================
# Drone Detect App — environment template
# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in.
# NEVER commit .env or the secrets/ folder.
# =====================================================================

# ---------------------------------------------------------------------
# SERVER (Go + Gin)
# ---------------------------------------------------------------------
SERVER_ADDR=:8080
GIN_MODE=debug                      # debug | release | test

# MongoDB (local Windows install, no authentication by default)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=drone_detect_app

# Export backend: start with csv, switch to sheets once Google is set up
EXPORT_BACKEND=csv                  # csv | sheets

# Google Sheets authentication — pick ONE mode:
#  (a) KEYLESS (use this if your organization blocks service account keys):
#      leave GOOGLE_CREDENTIALS_FILE empty and log in once with Application Default Credentials:
#      gcloud auth application-default login --impersonate-service-account=<SERVICE_ACCOUNT_EMAIL>
#  (b) KEY FILE (only where key creation is allowed): path to the service account JSON key
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=                    # the long ID in the spreadsheet URL
EXPORT_BATCH_SIZE=50
EXPORT_FLUSH_SECONDS=5
EXPORT_IDENTIFIED_ONLY=true         # sheets/CSV stream: only identified drones; MongoDB keeps everything

# Alerts (M7: live dashboard at GET / + /ws/alerts)
ALERT_ON_AUTHORIZED=false
# Optional: guard /ws/alerts + dashboard. Empty = open (local dev).
# Browsers pass it as ?token=SECRET.
ALERT_TOKEN=
ALERT_QUEUE_SIZE=64

# Server snapshot dir (served at /snapshots/ for thumbnails)
SNAPSHOT_DIR=../data/snapshots

# Identity resolver (simulated Remote ID)
BEACON_WINDOW_S=3
BEACON_RETENTION_S=60
RESOLVE_GRACE_MS=1500
VISUAL_MIN_CONF=0.5

# Shared secret between detector and server (optional but recommended).
# Generate: uv run python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable the check during early development.
DETECTOR_TOKEN=

# ---------------------------------------------------------------------
# DETECTOR (Python + YOLO)
# ---------------------------------------------------------------------
WS_URL=ws://localhost:8080/ws/detector
YOLO_WEIGHTS=./detector/models/drone.pt
YOLO_TARGET_CLASSES=drone           # comma-separated; use a stand-in (e.g. airplane) only for early tests
YOLO_CONF=0.35
YOLO_IMGSZ=640
ZONE_ID=north-gate
SOURCE_ID=cam-01
TRACK_COOLDOWN_SECONDS=30            # live streams only; files emit one summary per track at end
TRACK_MIN_FRAMES=3                  # file summary: tracks seen in fewer frames never emit
YOLO_STRIDE=1                       # video inference stride: 2-3 is faster, tracks may fragment
SNAPSHOT_DIR=./data/snapshots       # session-date subfolder; only identified tracks keep theirs

# Input data folders (your test material)
VIDEOS_DIR=./videos
IMAGES_DIR=./images

# Time basis: "video" = deterministic replay, "wall" = real clock (live camera)
DETECTOR_CLOCK=video
SCENARIO_START=2026-06-09T14:00:00Z

# Visual attributes, Stage C (M8, optional, off by default).
# Train detector/models/family.pt first (docs/TRAINING.md), then enable.
ATTR_FAMILY_ENABLED=false
ATTR_FAMILY_WEIGHTS=./detector/models/family.pt
ATTR_FAMILY_CONF=0.75

# ---------------------------------------------------------------------
# SIMULATOR (Remote ID beacons)
# ---------------------------------------------------------------------
BEACON_WS_URL=ws://localhost:8080/ws/beacons
HF_KEY=<YOUR_HUGGINGFACE_KEY>